{
  "about": "Labelled 'unclear rule' cases for the 'Suggest a rewrite' helper: a clause reviewers often overrule, the overruled quotes with the reviewers' reasons, and words the rewrite must keep so the rule keeps its intent. Drafted by Claude (Claude Code) on 17 Nov 2026; to be reviewed by a team member. RW-09 to RW-12 are hard cases added after the first run: notes that mention an internal codename (the draft must not repeat it) or figures, and a rule with only one overruled example.",
  "labelled_by": [
    "Claude (draft)"
  ],
  "cases": [
    {
      "id": "RW-01",
      "code": "CLAIM-02",
      "text": "Do not use the word guaranteed.",
      "notes": [
        {
          "quote": "guaranteed within one business day",
          "reason": "support response time is contractual"
        },
        {
          "quote": "response times are guaranteed",
          "reason": "legal approved this SLA wording"
        }
      ],
      "must_keep": [
        "guarantee"
      ]
    },
    {
      "id": "RW-02",
      "code": "TONE-03",
      "text": "Never use exclamation marks.",
      "notes": [
        {
          "quote": "Happy Diwali!",
          "reason": "festive greeting is allowed"
        },
        {
          "quote": "Congratulations!",
          "reason": "customer milestone post"
        }
      ],
      "must_keep": [
        "exclamation"
      ]
    },
    {
      "id": "RW-03",
      "code": "TERM-05",
      "text": "Never abbreviate anything in customer copy.",
