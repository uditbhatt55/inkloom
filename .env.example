# Copy to .env.local and fill in. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_DEPLOYMENT_DEFAULT=gpt-6-luna
AZURE_DEPLOYMENT_ESCALATION=gpt-6.1-sol

# true = simulated analyser, no AI calls
DEMO_MODE=true

# Cost control for the real model (optional): audits one account may start in 10 minutes, and real-model audits per organisation per day
# AI_BURST_MAX=20
# AI_DAILY_CAP=3000

# Playwright review-loop test (M4): two accounts in the demo org, one owner and one reviewer
E2E_OWNER_EMAIL=
E2E_OWNER_PASSWORD=
E2E_REVIEWER_EMAIL=
E2E_REVIEWER_PASSWORD=
